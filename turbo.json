{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_WEB_API_BASE_URL",
    "NEXT_PUBLIC_BACKOFFICE_API_BASE_URL",
    "NEXT_PUBLIC_WEBSITE_API_BASE_URL",
    "NEXT_PUBLIC_BASE_URL",
    "NEXT_PUBLIC_API_DOMAIN",
    "DOCS_AUTH_TOKEN",
    "NEXT_PUBLIC_SOCKET_BASE_URL",
    "NODE_ENV",
    "NEXT_PUBLIC_ONE_SIGNAL_APP_ID",
    "NEXT_PUBLIC_DESCOPE_PROJECT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}