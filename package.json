{
  "name": "schedulemate-frontend",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write --ignore-unknown",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "test": "turbo run test",
    "generate-types": "pnpm run generate:web && pnpm run generate:backoffice",
    "generate:web": "openapi-codegen gen --config openapi-codegen.config.ts web",
    "generate:backoffice": "openapi-codegen gen --config openapi-codegen.config.ts backoffice"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@openapi-codegen/cli": "^3.1.0",
    "@openapi-codegen/typescript": "^11.1.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.7.2",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "^15.5.0",
    "@swc/helpers": "^0.5.17",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "lodash": "^4.17.21",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=18"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
